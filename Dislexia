<style>
  :root{
    --cream:#FFF8EF;
    --cream-2:#FFEFDA;
    --ink:#3A2E2A;
    --ink-soft:#6B5B54;
    --white:#FFFFFF;

    --coral:#FF6F59;
    --coral-dark:#E44F3B;
    --teal:#1E9C89;
    --teal-dark:#137A6B;
    --sun:#FFB627;
    --sun-dark:#E29A0A;
    --purple:#8E6FD1;
    --purple-dark:#6E4FB0;
    --sky:#3E92CC;
    --sky-dark:#2B70A3;

    --shadow: 0 10px 30px rgba(58,46,42,0.12);
    --radius: 22px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Trebuchet MS','Segoe UI',Verdana,sans-serif;
    background:var(--cream);
    color:var(--ink);
    line-height:1.6;
  }
  h1,h2,h3{
    font-family:'Trebuchet MS','Segoe UI',Verdana,sans-serif;
    line-height:1.2;
    margin-top:0;
  }
  a{color:inherit;}
  img,svg{display:block;max-width:100%;}
  .container{max-width:1100px;margin:0 auto;padding:0 24px;}
  section{padding:64px 0;}
  .visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}

  /* ---------- NAV ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,248,239,0.92);
    backdrop-filter:blur(6px);
    border-bottom:3px solid var(--sun);
  }
  .nav-wrap{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;max-width:1100px;margin:0 auto;
  }
  .brand{
    display:flex;align-items:center;gap:10px;
    font-weight:800;font-size:1.25rem;color:var(--coral-dark);
    text-decoration:none;
  }
  .brand svg{width:36px;height:36px;flex-shrink:0;}
  nav ul{
    list-style:none;display:flex;gap:4px;margin:0;padding:0;flex-wrap:wrap;
  }
  nav button{
    font:inherit;font-weight:700;font-size:0.95rem;
    background:none;border:none;cursor:pointer;
    color:var(--ink-soft);padding:10px 14px;border-radius:999px;
    transition:background .2s, color .2s;
  }
  nav button:hover, nav button:focus-visible{background:var(--cream-2);color:var(--coral-dark);}
  nav button[aria-current="page"]{background:var(--coral);color:#fff;}
  .nav-toggle{display:none;background:var(--coral);color:#fff;border:none;border-radius:12px;padding:10px 14px;font-weight:800;font-size:1rem;cursor:pointer;}

  @media (max-width:840px){
    nav ul{display:none;width:100%;flex-direction:column;background:var(--white);border-radius:16px;padding:10px;box-shadow:var(--shadow);margin-top:10px;}
    nav ul.open{display:flex;}
    .nav-toggle{display:block;}
    .nav-wrap{flex-wrap:wrap;}
  }

  /* ---------- PAGES ---------- */
  .page{display:none;animation:fade .35s ease;}
  .page.active{display:block;}
  @keyframes fade{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  /* ---------- HERO ---------- */
  .hero{
    padding:70px 0 40px;
    background:
      radial-gradient(circle at 15% 20%, rgba(255,182,39,0.25), transparent 40%),
      radial-gradient(circle at 85% 10%, rgba(62,146,204,0.20), transparent 40%),
      radial-gradient(circle at 75% 80%, rgba(142,111,209,0.18), transparent 40%);
  }
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:40px;align-items:center;}
  @media (max-width:800px){.hero-grid{grid-template-columns:1fr;}}
  .eyebrow{
    display:inline-block;background:var(--sun);color:var(--ink);
    font-weight:800;font-size:0.8rem;letter-spacing:0.04em;text-transform:uppercase;
    padding:6px 14px;border-radius:999px;margin-bottom:14px;
  }
  .hero h1{font-size:2.6rem;color:var(--coral-dark);}
  .hero p.lead{font-size:1.15rem;color:var(--ink-soft);max-width:44ch;}
  .cta-row{display:flex;gap:14px;flex-wrap:wrap;margin-top:24px;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;
    font-weight:800;font-size:1rem;text-decoration:none;cursor:pointer;
    padding:14px 26px;border-radius:999px;border:none;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:var(--coral);color:#fff;box-shadow:0 8px 20px rgba(255,111,89,0.35);}
  .btn-primary:hover{background:var(--coral-dark);}
  .btn-ghost{background:#fff;color:var(--coral-dark);border:2px solid var(--coral);}

  .hero-art{position:relative;height:320px;}
  .blob{position:absolute;border-radius:50%;}

  /* ---------- STAT / VALUE CARDS ---------- */
  .value-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:10px;}
  @media (max-width:760px){.value-grid{grid-template-columns:1fr;}}
  .card{
    background:var(--white);border-radius:var(--radius);padding:26px;box-shadow:var(--shadow);
    border-top:6px solid var(--teal);
  }
  .card h3{color:var(--teal-dark);font-size:1.15rem;margin-bottom:8px;}
  .card p{color:var(--ink-soft);margin:0;font-size:0.97rem;}
  .card .icon{font-size:1.8rem;margin-bottom:10px;}

  /* ---------- TOPIC GRID (Inicio) ---------- */
  .section-title{text-align:center;max-width:640px;margin:0 auto 40px;}
  .section-title .eyebrow{margin-bottom:10px;}
  .section-title h2{font-size:2rem;color:var(--ink);}
  .section-title p{color:var(--ink-soft);}

  .topic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  @media (max-width:900px){.topic-grid{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:480px){.topic-grid{grid-template-columns:1fr;}}
  .topic-card{
    background:var(--white);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow);
    cursor:pointer;border:none;text-align:left;width:100%;font-family:inherit;
    transition:transform .15s ease;
  }
  .topic-card:hover, .topic-card:focus-visible{transform:translateY(-4px);}
  .topic-badge{
    width:52px;height:52px;border-radius:16px;display:flex;align-items:center;justify-content:center;
    font-size:1.6rem;margin-bottom:14px;color:#fff;
  }
  .topic-card h3{font-size:1.1rem;margin-bottom:6px;}
  .topic-card p{color:var(--ink-soft);font-size:0.92rem;margin:0;}
  .topic-card .goto{margin-top:12px;font-weight:800;font-size:0.85rem;display:inline-block;}

  .t-dislexia .topic-badge{background:var(--teal);}
  .t-dislexia .goto{color:var(--teal-dark);}
  .t-discalculia .topic-badge{background:var(--sun);}
  .t-discalculia .goto{color:var(--sun-dark);}
  .t-tdah .topic-badge{background:var(--purple);}
  .t-tdah .goto{color:var(--purple-dark);}
  .t-tea .topic-badge{background:var(--sky);}
  .t-tea .goto{color:var(--sky-dark);}

  /* ---------- TOPIC PAGE LAYOUT ---------- */
  .topic-hero{padding:50px 0 10px;}
  .topic-hero-inner{display:flex;align-items:center;gap:18px;flex-wrap:wrap;}
  .topic-icon-lg{width:76px;height:76px;border-radius:22px;display:flex;align-items:center;justify-content:center;font-size:2.4rem;color:#fff;flex-shrink:0;}
  .topic-hero h1{font-size:2.1rem;margin-bottom:6px;}
  .topic-hero .tagline{color:var(--ink-soft);font-size:1.05rem;max-width:60ch;}

  .content-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:36px;}
  @media (max-width:760px){.content-grid{grid-template-columns:1fr;}}
  .panel{background:var(--white);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);}
  .panel h3{font-size:1.2rem;margin-bottom:14px;}
  .panel ul{margin:0;padding-left:1.2em;color:var(--ink-soft);}
  .panel li{margin-bottom:8px;}

  .tips-strip{margin-top:28px;border-radius:var(--radius);padding:28px;color:#fff;}
  .tips-strip h3{color:#fff;margin-bottom:14px;}
  .tips-strip ol{margin:0;padding-left:1.2em;}
  .tips-strip li{margin-bottom:10px;}

  .resource-box{
    margin-top:28px;background:var(--cream-2);border:2px dashed var(--sun-dark);
    border-radius:var(--radius);padding:24px;display:flex;gap:16px;align-items:flex-start;flex-wrap:wrap;
  }
  .resource-box .r-icon{font-size:1.8rem;}
  .resource-box h4{margin:0 0 6px;}
  .resource-box p{margin:0;color:var(--ink-soft);}

  /* ---------- SOBRE / VALORES ---------- */
  .pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px;}
  @media (max-width:900px){.pillars{grid-template-columns:repeat(2,1fr);}}
  @media (max-width:480px){.pillars{grid-template-columns:1fr;}}
  .about-me{display:flex;gap:36px;align-items:center;flex-wrap:wrap;background:var(--white);border-radius:var(--radius);padding:32px;box-shadow:var(--shadow);}
  .about-photo img{width:200px;height:200px;border-radius:50%;object-fit:cover;border:6px solid var(--cream-2);box-shadow:0 6px 18px rgba(58,46,42,0.18);display:block;}
  .about-text{flex:1;min-width:280px;}
  .about-text .eyebrow{margin-bottom:10px;}
  .about-text h2{font-size:1.6rem;margin-bottom:2px;color:var(--ink);}
  .about-role{color:var(--coral-dark);font-weight:800;margin:0 0 14px;font-size:0.98rem;}
  .about-text p.bio{color:var(--ink-soft);margin:0;}
  .about-quote{margin-top:18px;font-style:italic;color:var(--ink);border-left:4px solid var(--sun);padding-left:16px;font-size:1.05rem;}
  @media (max-width:640px){.about-me{flex-direction:column;text-align:center;padding:26px;}.about-quote{border-left:none;border-top:4px solid var(--sun);padding-left:0;padding-top:14px;}}
  .pillar{text-align:center;padding:20px;}
  .pillar .icon{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.7rem;color:#fff;margin:0 auto 12px;}

  .timeline{margin-top:30px;border-left:4px solid var(--sun);padding-left:24px;display:flex;flex-direction:column;gap:22px;}
  .timeline .step{position:relative;}
  .timeline .step::before{content:"";position:absolute;left:-31px;top:4px;width:16px;height:16px;border-radius:50%;background:var(--coral);border:3px solid var(--cream);}
  .timeline h4{margin:0 0 4px;color:var(--coral-dark);}
  .timeline p{margin:0;color:var(--ink-soft);}

  /* ---------- CONTACT ---------- */
  .contact-wrap{display:grid;grid-template-columns:1fr 1fr;gap:40px;}
  @media (max-width:760px){.contact-wrap{grid-template-columns:1fr;}}
  form{background:var(--white);border-radius:var(--radius);padding:30px;box-shadow:var(--shadow);}
  .field{margin-bottom:18px;}
  label{display:block;font-weight:800;margin-bottom:6px;font-size:0.92rem;color:var(--ink);}
  input, select, textarea{
    width:100%;padding:12px 14px;border-radius:12px;border:2px solid #EADFD3;
    font:inherit;background:var(--cream);color:var(--ink);
  }
  input:focus, select:focus, textarea:focus{outline:3px solid var(--sun);border-color:var(--sun-dark);}
  textarea{resize:vertical;min-height:110px;}
  .form-note{font-size:0.85rem;color:var(--ink-soft);margin-top:10px;}
  .confirm{display:none;background:var(--teal);color:#fff;padding:16px 20px;border-radius:16px;font-weight:700;margin-top:16px;}
  .confirm.show{display:block;}

  .contact-side .card{border-top-color:var(--sky);margin-bottom:18px;}

  /* ---------- FOOTER ---------- */
  footer{background:var(--ink);color:#fff;padding:40px 0;margin-top:20px;}
  footer .container{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
  footer p{margin:0;color:#D8CFC9;font-size:0.9rem;}
  footer .brand{color:#fff;}

  .divider-wave{width:100%;height:60px;display:block;}

  .skip-link{position:absolute;left:-999px;top:0;background:#fff;padding:10px;z-index:100;}
  .skip-link:focus{left:10px;}
</style>
</head>
<body>

