<header>
  <div class="nav-wrap">
    <a href="#" class="brand" data-nav="inicio">
      <svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="22" fill="#FF6F59"/><circle cx="16" cy="20" r="6" fill="#FFB627"/><circle cx="32" cy="20" r="6" fill="#1E9C89"/><circle cx="24" cy="32" r="6" fill="#3E92CC"/></svg>
